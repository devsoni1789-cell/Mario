<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true">
<com.example.dinorush.GameView android:id="@+id/gameView" android:layout_width="match_parent" android:layout_height="match_parent"/>
<LinearLayout android:id="@+id/splashOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:background="@color/panel_bg_solid"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="@color/text_light" android:textSize="42sp" android:textStyle="bold"/></LinearLayout>
<LinearLayout android:id="@+id/menuOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="32dp" android:background="@color/panel_bg_solid"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="@color/text_light" android:textSize="40sp" android:textStyle="bold"/><Button android:id="@+id/btnPlay" style="@style/MenuButton" android:text="@string/btn_play"/><Button android:id="@+id/btnHighScores" style="@style/MenuButton" android:text="@string/btn_high_scores"/><Button android:id="@+id/btnSettings" style="@style/MenuButton" android:text="@string/btn_settings"/><Button android:id="@+id/btnHowToPlay" style="@style/MenuButton" android:text="@string/btn_how_to_play"/><Button android:id="@+id/btnExit" style="@style/MenuButton" android:text="@string/btn_exit"/></LinearLayout>
<LinearLayout android:id="@+id/hudOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:padding="12dp"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/panel_bg" android:padding="8dp"><TextView android:id="@+id/hudScore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Score: 0" android:textColor="@color/text_light"/><TextView android:id="@+id/hudBest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Best: 0" android:textColor="@color/text_muted"/><TextView android:id="@+id/hudDistance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Distance: 0m" android:textColor="@color/text_muted"/><TextView android:id="@+id/hudCoins" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Coins: 0" android:textColor="@color/brand_accent"/></LinearLayout><TextView android:id="@+id/hudPowerUp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:visibility="gone" android:background="@drawable/panel_bg" android:textColor="@color/brand_accent"/><ImageButton android:id="@+id/btnPause" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|end" android:layout_marginEnd="8dp" android:layout_marginTop="8dp" android:src="@android:drawable/ic_media_pause" app:tint="@color/text_light"/><LinearLayout android:id="@+id/onScreenControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:layout_marginBottom="8dp" android:visibility="gone"><Button android:id="@+id/btnOnScreenDuck" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:text="DUCK"/><Button android:id="@+id/btnOnScreenJump" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:text="JUMP"/></LinearLayout></LinearLayout>
<LinearLayout android:id="@+id/pauseOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:gravity="center" android:orientation="vertical" android:background="@color/panel_bg_solid"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/paused_title" android:textColor="@color/text_light" android:textSize="34sp"/><Button android:id="@+id/btnResume" style="@style/MenuButton" android:text="@string/btn_resume"/><Button android:id="@+id/btnPauseRestart" style="@style/MenuButton" android:text="@string/btn_restart"/><Button android:id="@+id/btnPauseMainMenu" style="@style/MenuButton" android:text="@string/btn_main_menu"/></LinearLayout>
<LinearLayout android:id="@+id/gameOverOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:gravity="center" android:orientation="vertical" android:background="@color/panel_bg_solid"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/game_over_title" android:textColor="@color/text_light" android:textSize="34sp"/><TextView android:id="@+id/goScore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_light"/><TextView android:id="@+id/goBest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_light"/><TextView android:id="@+id/goDistance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_light"/><TextView android:id="@+id/goCoins" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_light"/><Button android:id="@+id/btnGoRestart" style="@style/MenuButton" android:text="@string/btn_restart"/><Button android:id="@+id/btnGoMainMenu" style="@style/MenuButton" android:text="@string/btn_main_menu"/></LinearLayout>
<ScrollView android:id="@+id/settingsOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:background="@color/panel_bg_solid"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_title" android:textColor="@color/text_light" android:textSize="30sp"/><Switch android:id="@+id/switchSound" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_sound" android:textColor="@color/text_light"/><Switch android:id="@+id/switchMusic" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_music" android:textColor="@color/text_light"/><Switch android:id="@+id/switchVibration" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_vibration" android:textColor="@color/text_light"/><Switch android:id="@+id/switchOnScreenControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_controls" android:textColor="@color/text_light"/><RadioGroup android:id="@+id/radioGraphics" android:layout_width="match_parent" android:layout_height="wrap_content"><RadioButton android:id="@+id/radioLow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Low" android:textColor="@color/text_light"/><RadioButton android:id="@+id/radioNormal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Normal" android:textColor="@color/text_light"/><RadioButton android:id="@+id/radioHigh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="High" android:textColor="@color/text_light"/></RadioGroup><Button android:id="@+id/btnResetScores" style="@style/MenuButton" android:text="@string/btn_reset_scores"/><Button android:id="@+id/btnAbout" style="@style/MenuButton" android:text="@string/btn_about"/><Button android:id="@+id/btnSettingsBack" style="@style/MenuButton" android:text="@string/btn_back"/></LinearLayout></ScrollView>
<ScrollView android:id="@+id/howToOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:background="@color/panel_bg_solid"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/how_to_play_title" android:textColor="@color/text_light" android:textSize="30sp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap to jump. Hold for a higher jump. Swipe down to duck. Collect coins and power-ups. Avoid obstacles." android:textColor="@color/text_light" android:textSize="18sp"/><Button android:id="@+id/btnHowToBack" style="@style/MenuButton" android:text="@string/btn_back"/></LinearLayout></ScrollView>
<ScrollView android:id="@+id/highScoresOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:background="@color/panel_bg_solid"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/high_scores_title" android:textColor="@color/text_light" android:textSize="30sp"/><TextView android:id="@+id/statBest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_light"/><TextView android:id="@+id/statLongestDistance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_light"/><TextView android:id="@+id/statTotalCoins" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_light"/><TextView android:id="@+id/statTotalJumps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_light"/><TextView android:id="@+id/statObstaclesPassed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_light"/><TextView android:id="@+id/statRunsPlayed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_light"/><Button android:id="@+id/btnHighScoresBack" style="@style/MenuButton" android:text="@string/btn_back"/></LinearLayout></ScrollView>
</FrameLayout>